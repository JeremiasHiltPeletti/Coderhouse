# Copiá este archivo como .env y completá lo que necesites.

# Contraseña para entrar al panel (obligatoria la primera vez; luego podés cambiarla).
PANEL_PASSWORD=
# Puerto y dirección. Por seguridad escucha solo en localhost.
PORT=4747
HOST=127.0.0.1
# URL pública HTTPS del panel (opcional). Si existe, la autorización en WordPress vuelve sola al panel.
PANEL_PUBLIC_URL=

# Clave para cifrar las credenciales de los sitios (si falta se genera data/.secret).
CENTINELA_SECRET=

# --- Análisis inteligente (recomendado) ---
# Claude investiga foros, reseñas y avisos de seguridad y redacta la decisión.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Bases de datos de vulnerabilidades (opcionales, mejoran la precisión) ---
WPSCAN_API_TOKEN=
WORDFENCE_API_KEY=
