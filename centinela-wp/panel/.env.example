# En tu PC: copiá este archivo como .env y completá lo que necesites.
# En Hostinger: cargá estas mismas variables en "Variables de entorno" de la app
# (o subí este archivo con "Importar .env").

# Contraseña para entrar al panel. OBLIGATORIA en un servidor (mínimo 10 caracteres).
PANEL_PASSWORD=

# URL pública HTTPS del panel, p. ej. https://panel.tudominio.com
# Con ella, la autorización en WordPress vuelve sola al panel.
PANEL_PUBLIC_URL=

# Clave larga y secreta que usa la tarea cron del hosting para llamar a /api/cron.
CRON_TOKEN=

# Clave para cifrar las credenciales de los sitios. Recomendado en un servidor:
# si la perdés, tenés que volver a conectar los sitios.
CENTINELA_SECRET=

# --- Análisis inteligente (recomendado) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Bases de datos de vulnerabilidades (opcionales) ---
WPSCAN_API_TOKEN=
WORDFENCE_API_KEY=

# --- Avanzado (normalmente no hace falta tocarlo) ---
# Copias de seguridad que se guardan en el panel por sitio.
PANEL_KEEP_BACKUPS=10
# Carpeta de datos. En Hostinger se usa ~/centinela-data automáticamente.
CENTINELA_DATA_DIR=
# Solo en tu PC (en Hostinger NO los definas: el hosting asigna el puerto).
# PORT=4747
# HOST=127.0.0.1
